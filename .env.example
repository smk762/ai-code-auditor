# Hosts are placeholders (<STATEFUL_HOST>, <AGENT_HOST>, <ORCHESTRATOR_HOST>): put the real
# LAN host/IP in your local .env, never in this file.

# ── App ──────────────────────────────────────────────────────────────────────
APP_NAME=ai-code-auditor
ENV=dev
REQUEST_TIMEOUT_MS=8000
LOG_LEVEL=INFO

# ── PostgreSQL (Jarrah stateful node — <STATEFUL_HOST>:5432) ───────────────────
# Create role/db ai_audit on Jarrah if missing; replace user/pass.
DATABASE_URL=postgresql://testuser:testpass@<STATEFUL_HOST>:5432/ai_audit
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# ── Redis (Jarrah — <STATEFUL_HOST>:6379) ───────────────────────────────────────
REDIS_URL=redis://:testpass@<STATEFUL_HOST>:6379/0
REDIS_LOCK_REQUIRED=true

# ── Object Storage (MinIO on Jarrah — <STATEFUL_HOST>:9000) ───────────────────
S3_ENDPOINT_URL=http://<STATEFUL_HOST>:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=uploads
S3_REGION=us-east-1
CDN_BASE_URL=

# ── Auth / JWT ───────────────────────────────────────────────────────────────
JWT_ISSUER=ai-code-auditor
JWT_AUDIENCE=ai-code-auditor
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
AI_AUDIT_AUTH_MODE=false
AI_AUDIT_AUTH_CODE_ENV=AI_AUDIT_AUTH_CODE
AI_AUDIT_AUTH_CODE=
AI_AUDIT_AUTH_CODE_INPUT=
AI_AUDIT_AUTH_TOKEN=
# When set, mutating audit-api routes require this value via X-API-Token.
AI_AUDIT_API_TOKEN=
# Host bind for docker-compose audit-api publish (default 127.0.0.1).
AUDIT_API_BIND_IP=127.0.0.1
AUDIT_API_PORT=8765

# ── LLM / Night Conductor (API keys; local Ollama optional fallback) ─────────
AI_AUDIT_LLM_PROVIDER=anthropic
AI_AUDIT_LLM_MODEL=claude-opus-4-5
AI_AUDIT_LLM_ENDPOINT=https://api.anthropic.com/v1/messages
AI_AUDIT_LLM_TIMEOUT_S=180
AI_AUDIT_LLM_API_KEY_ENV=ANTHROPIC_API_KEY
AI_AUDIT_LLM_TEMPERATURE=0.1
AI_AUDIT_CONDUCTOR_MODEL=anthropic/claude-opus-4-5
AI_AUDIT_WORKER_MODEL=anthropic/claude-opus-4-5
AI_AUDIT_PR_REVIEW_MODEL=anthropic/claude-opus-4-5
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=

# Ecosystem governance no longer waits on VRAM by default (set 0 to restore).
AI_AUDIT_SKIP_GPU_SCHEDULER=1

# Rest window timezone override (IANA). Checked-in default is UTC (config/rest_windows.yaml);
# set your host timezone so the window lines up with the systemd timers.
# AI_AUDIT_REST_TZ=UTC

# Mithrandir companion (Jarrah) — unset uses default; empty string disables webhook.
AI_AUDIT_PUBLIC_BASE_URL=http://<AGENT_HOST>:8765
# AI_AUDIT_MITHRANDIR_WEBHOOK_URL=http://<STATEFUL_HOST>:8400/api/companion/events

AI_AUDIT_EMBEDDER_PROVIDER=local-hash
AI_AUDIT_EMBEDDER_MODEL=local-hash
AI_AUDIT_EMBEDDER_DIM=64
AI_AUDIT_EMBEDDER_ENDPOINT=
AI_AUDIT_EMBEDDER_API_KEY_ENV=
# Point rag-ingest Ollama at Jarrah so embeddings do not wake Dragon GPU:
# OLLAMA_BASE_URL=http://<STATEFUL_HOST>:11434

LLM_HEALTHCHECK_REQUIRED=false
EMBEDDER_HEALTHCHECK_REQUIRED=false
AI_AUDIT_DUP_AST_MIN=0.72
AI_AUDIT_DUP_EMBED_MIN=0.78
AI_AUDIT_DUP_SIG_MIN=0.60
AI_AUDIT_DUP_LSH_BANDS=8
AI_AUDIT_DUP_LSH_ROWS=8

# ── Auditor Paths / Runtime ──────────────────────────────────────────────────
AI_AUDIT_OUTPUT_DIR=reports
AI_AUDIT_GRAPH_DB_PATH=graph/ecosystem_graph.db
AI_AUDIT_EMBEDDING_INDEX_PATH=index/code_embeddings.faiss
AI_AUDIT_ARCH_MEMORY_PATH=memory/architecture_memory.md
AI_AUDIT_LOG_LEVEL=INFO
AI_AUDIT_LOG_FILE_PATH=pipeline.log
AI_AUDIT_RESUME_RUN_ID=

# ── Optional Remote Repo Access ──────────────────────────────────────────────
# If config/ecosystem.yaml uses access_token_env: GITHUB_TOKEN
GITHUB_TOKEN=
# Blocked-PR intel (GET /audit/prs, morning briefing) reads open PRs over GraphQL with
# GITHUB_TOKEN; it refreshes after each merge-poll. Set 0 to turn it off.
# AI_AUDIT_PR_INTEL=1
GITLAB_TOKEN=
BITBUCKET_TOKEN=

# ── Ecosystem Services (reserved/integration-ready) ─────────────────────────
LORA_BACKEND=selfhosted
LORA_API_BASE_URL=http://<STATEFUL_HOST>:8010
LORA_API_KEY=change-me
LORA_API_TIMEOUT_MS=120000
LORA_JOB_TIMEOUT_MS=7200000
LORA_JOB_POLL_INTERVAL_MS=5000
LORA_API_AUTH_HEADER=Authorization
LORA_API_AUTH_SCHEME=Bearer
LORA_API_EXTRA_HEADERS_JSON=
LORA_API_JOBS_PATH=/v1/lora/jobs

ORCHESTRATOR_BACKEND=selfhosted
ORCHESTRATOR_API_BASE_URL=http://<ORCHESTRATOR_HOST>:8030
ORCHESTRATOR_API_KEY=
ORCHESTRATOR_API_TIMEOUT_MS=30000
ORCHESTRATOR_RUN_TIMEOUT_MS=600000
ORCHESTRATOR_RUN_POLL_INTERVAL_MS=3000

IMAGE_BACKEND=selfhosted
IMAGE_API_BASE_URL=http://<STATEFUL_HOST>:8003
IMAGE_API_KEY=
IMAGE_API_GENERATE_PATH=/images/generate
IMAGE_API_IMG2IMG_PATH=/images/img2img
IMAGE_API_JOBS_PATH=/images/jobs
IMAGE_API_TIMEOUT_MS=120000
IMAGE_API_JOB_TIMEOUT_MS=300000
IMAGE_API_JOB_POLL_INTERVAL_MS=2000

VIDEO_BACKEND=selfhosted
VIDEO_API_BASE_URL=http://<STATEFUL_HOST>:8000
VIDEO_API_KEY=
VIDEO_API_GENERATE_PATH=/videos/generate
VIDEO_API_JOBS_PATH=/videos/jobs
VIDEO_API_TIMEOUT_MS=120000
VIDEO_API_JOB_TIMEOUT_MS=600000
VIDEO_API_JOB_POLL_INTERVAL_MS=3000

# ── Docker Compose (bind-mount ownership) ─────────────────────────────────────
# Match the container user to your host user so ./reports, ./graph, etc. are
# not created as root. Copy to `.env` and set to your ids: `id -u` / `id -g`.
HOST_UID=1000
HOST_GID=1000

# ── Gothmog GPU capacity gate ─────────────────────────────────────────────────
# Set GOTHMOG_URL to delegate GPU scheduling to gothmog's capacity API.
# GOTHMOG_API_KEY must match gothmog's API_KEY env var.
# Leave GOTHMOG_URL blank to fall back to direct nvidia-smi / service polling.
GOTHMOG_URL=http://<ORCHESTRATOR_HOST>:8030
GOTHMOG_API_KEY=

# ── Audit HTTP API ────────────────────────────────────────────────────────────
# docker compose up -d --build audit-api
AUDIT_API_PORT=8765
AUDIT_API_BIND_IP=0.0.0.0
# Optional local Ollama generate endpoint (Jarrah embeddings / light models):
# AI_AUDIT_LLM_ENDPOINT=http://<STATEFUL_HOST>:11434/api/generate

# rag-chat API key for `ai-audit repair --apply/--commit/--push` (rag-chat requires it for
# write runs; read-only review/suggest runs work without). Create at http://<AGENT_HOST>:9150/ui/api-keys.
# Separate from AI_AUDIT_AUTH_TOKEN, which is only checked locally.
# RAG_CHAT_API_KEY=

# ── Merge-to-dev pack / RAG refresh (lightweight; nightly stays source of truth) ─
# Preferred on LAN: hourly GitHub API poll (ai-audit merge-poll --schedule).
AI_AUDIT_MERGE_POLL_ENABLED=1
# AI_AUDIT_MERGE_POLL_STATE=reports/merge_poll_state.json
AI_AUDIT_MERGE_HOOK_ENABLED=1
AI_AUDIT_MERGE_BRANCH=dev
AI_AUDIT_MERGE_DEBOUNCE_S=900
AI_AUDIT_MERGE_GLOBAL_GAP_S=120
# Optional webhook (only if audit-api is publicly reachable):
AI_AUDIT_MERGE_WEBHOOK_SECRET=
# Pack slim-ingest after emit (0 to disable):
# AI_AUDIT_PACK_RAG_INGEST=1
# Pack token-savings metric after each pack emit (reports/pack_savings.json + _history.jsonl)
# AI_AUDIT_PACK_SAVINGS=1
# RAG ingest URL (LAN IP when rag-ingest binds off localhost):
# AI_AUDIT_RAG_INGEST_URL=http://<AGENT_HOST>:9050/ingest

# Rules file that "Approve" on /ui/architecture writes to (the CLI uses --rules-path).
# In Docker, config/ is baked into the image; point this at the mounted checkout to persist:
# AI_AUDIT_ARCH_RULES_PATH=/repos/ai-code-auditor/config/architecture_rules.yaml

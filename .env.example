# ── App ──────────────────────────────────────────────────────────────────────
APP_NAME=ai-code-auditor
ENV=dev
REQUEST_TIMEOUT_MS=8000
LOG_LEVEL=INFO

# ── PostgreSQL ───────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://testuser:testpass@192.168.1.128:5432/testdb
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://:testpass@192.168.1.128:6379/0
REDIS_LOCK_REQUIRED=true

# ── Object Storage (S3 / MinIO) ─────────────────────────────────────────────
S3_ENDPOINT_URL=http://192.168.1.128:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=uploads
S3_REGION=us-east-1
CDN_BASE_URL=

# ── Auth / JWT ───────────────────────────────────────────────────────────────
JWT_ISSUER=fastapi-prod-skeleton
JWT_AUDIENCE=fastapi-prod-skeleton
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
AI_AUDIT_AUTH_MODE=false
AI_AUDIT_AUTH_CODE_ENV=AI_AUDIT_AUTH_CODE
AI_AUDIT_AUTH_CODE=
AI_AUDIT_AUTH_CODE_INPUT=
AI_AUDIT_AUTH_TOKEN=

# ── LLM / Embedder ───────────────────────────────────────────────────────────
AI_AUDIT_LLM_PROVIDER=ollama
AI_AUDIT_LLM_MODEL=deepseek-coder-33b
AI_AUDIT_LLM_ENDPOINT=http://192.168.1.128:11434/api/generate
AI_AUDIT_LLM_TIMEOUT_S=90
AI_AUDIT_LLM_API_KEY_ENV=
AI_AUDIT_LLM_TEMPERATURE=0.1

AI_AUDIT_EMBEDDER_PROVIDER=local-hash
AI_AUDIT_EMBEDDER_MODEL=local-hash
AI_AUDIT_EMBEDDER_DIM=64
AI_AUDIT_EMBEDDER_ENDPOINT=
AI_AUDIT_EMBEDDER_API_KEY_ENV=
OPENAI_API_KEY=

LLM_HEALTHCHECK_REQUIRED=false
EMBEDDER_HEALTHCHECK_REQUIRED=false
AI_AUDIT_DUP_AST_MIN=0.72
AI_AUDIT_DUP_EMBED_MIN=0.78
AI_AUDIT_DUP_SIG_MIN=0.60
AI_AUDIT_DUP_LSH_BANDS=8
AI_AUDIT_DUP_LSH_ROWS=8

# ── Auditor Paths / Runtime ──────────────────────────────────────────────────
AI_AUDIT_OUTPUT_DIR=reports
AI_AUDIT_GRAPH_DB_PATH=graph/ecosystem_graph.db
AI_AUDIT_EMBEDDING_INDEX_PATH=index/code_embeddings.faiss
AI_AUDIT_ARCH_MEMORY_PATH=memory/architecture_memory.md
AI_AUDIT_LOG_LEVEL=INFO
AI_AUDIT_LOG_FILE_PATH=pipeline.log
AI_AUDIT_RESUME_RUN_ID=

# ── Optional Remote Repo Access ──────────────────────────────────────────────
# If config/ecosystem.yaml uses access_token_env: GITHUB_TOKEN
GITHUB_TOKEN=
GITLAB_TOKEN=
BITBUCKET_TOKEN=

# ── Ecosystem Services (reserved/integration-ready) ─────────────────────────
LORA_BACKEND=selfhosted
LORA_API_BASE_URL=http://192.168.1.109:8010
LORA_API_KEY=change-me
LORA_API_TIMEOUT_MS=120000
LORA_JOB_TIMEOUT_MS=7200000
LORA_JOB_POLL_INTERVAL_MS=5000
LORA_API_AUTH_HEADER=Authorization
LORA_API_AUTH_SCHEME=Bearer
LORA_API_EXTRA_HEADERS_JSON=
LORA_API_JOBS_PATH=/v1/lora/jobs

ORCHESTRATOR_BACKEND=selfhosted
ORCHESTRATOR_API_BASE_URL=http://192.168.1.86:8030
ORCHESTRATOR_API_KEY=
ORCHESTRATOR_API_TIMEOUT_MS=30000
ORCHESTRATOR_RUN_TIMEOUT_MS=600000
ORCHESTRATOR_RUN_POLL_INTERVAL_MS=3000

IMAGE_BACKEND=selfhosted
IMAGE_API_BASE_URL=http://192.168.1.109:8003
IMAGE_API_KEY=
IMAGE_API_GENERATE_PATH=/images/generate
IMAGE_API_IMG2IMG_PATH=/images/img2img
IMAGE_API_JOBS_PATH=/images/jobs
IMAGE_API_TIMEOUT_MS=120000
IMAGE_API_JOB_TIMEOUT_MS=300000
IMAGE_API_JOB_POLL_INTERVAL_MS=2000

VIDEO_BACKEND=selfhosted
VIDEO_API_BASE_URL=http://192.168.1.109:8000
VIDEO_API_KEY=
VIDEO_API_GENERATE_PATH=/videos/generate
VIDEO_API_JOBS_PATH=/videos/jobs
VIDEO_API_TIMEOUT_MS=120000
VIDEO_API_JOB_TIMEOUT_MS=600000
VIDEO_API_JOB_POLL_INTERVAL_MS=3000

# ── Docker Compose (bind-mount ownership) ─────────────────────────────────────
# Match the container user to your host user so ./reports, ./graph, etc. are
# not created as root. Copy to `.env` and set to your ids: `id -u` / `id -g`.
HOST_UID=1000
HOST_GID=1000

# ── Gothmog GPU capacity gate ─────────────────────────────────────────────────
# Set GOTHMOG_URL to delegate GPU scheduling to gothmog's capacity API.
# GOTHMOG_API_KEY must match gothmog's API_KEY env var.
# Leave GOTHMOG_URL blank to fall back to direct nvidia-smi / service polling.
GOTHMOG_URL=http://192.168.1.128:8030
GOTHMOG_API_KEY=

# ── Audit HTTP API (audit-api Docker profile) ─────────────────────────────────
# docker compose --profile audit-api up -d audit-api
AUDIT_API_PORT=8765
AUDIT_API_BIND_IP=0.0.0.0
